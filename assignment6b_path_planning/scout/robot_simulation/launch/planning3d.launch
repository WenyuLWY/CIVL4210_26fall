<?xml version="1.0"?>
<launch>

  <!-- 1. sim localizaiton -->
  <node pkg="robot_simulation" type="localization_sim" name="localization_sim_node" output="screen">
    <param name="laserCloudTopic"           value="/velodyne_points"/>
    <param name="robotName"                 value="scout"/>
    <param name="publishTF"                 value="false"/>
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="mappingPublisher"  args="0 0 0 0 0 0 map odom"/>

  <!-- This is to just to visualize the localization trajectory -->
  <node pkg="hector_trajectory_server" type="hector_trajectory_server" name="hector_trajectory_server" output="screen">
      <param name="target_frame_name" type="string" value="map" />
      <param name="source_frame_name" type="string" value="base_link" />
      <param name="trajectory_update_rate" type="double" value="5.0" />
      <param name="trajectory_publish_rate" type="double" value="5.0" />
  </node>

  <!-- sensor_input node for transformation -->
  <arg name="lidar_frame_id"              default="velodyne"/>
  <arg name="robot_base_frame_id"         default="dummy_base_link"/>
  <arg name="odom_frame_id"               default="odom"/> 
  <arg name="odometry_topic"              default="/Odometry"/>
  <arg name="raw_cloud_topic"             default="/velodyne_points"/> 
  <arg name="mode"                        default="3d"/>
  <arg name="source_frame_id"             default="dummy_base_link"/>

  <node pkg="robot_simulation" type="sensor_input" name="sensor_input_node" output="screen">
      <param name="lidar_frame_id"          value="$(arg lidar_frame_id)"/>
      <param name="robot_base_frame_id"     value="$(arg robot_base_frame_id)"/>
      <param name="odom_frame_id"           value="$(arg odom_frame_id)"/>
      <param name="sub_odometry_topic"          value="$(arg odometry_topic)"/>
      <param name="raw_cloud_topic"         value="$(arg raw_cloud_topic)"/>
      <param name="mode"                    value="$(arg mode)"/>
      <param name="source_frame_id"         value="$(arg source_frame_id)"/>
      <!-- <param name="vehicle_crop_box"        value="-0.35 0.35 -0.35 0.35 -0.5 0.0"/> -->
      <param name="vehicle_crop_box"        value="-0.35 0.35 -0.35 0.35 -0.5 0.0"/>
  </node>

 
</launch>
