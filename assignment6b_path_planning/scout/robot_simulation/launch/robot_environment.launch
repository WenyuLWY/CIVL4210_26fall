<?xml version="1.0"?>
<launch>

    <param name="/use_sim_time"             value="true" />

    <!-- <arg name="robot_namespace" default="/"/> -->
    <!-- <arg name="world_name" default="$(find scout_gazebo_sim)/worlds/clearpath_playpen.world"/> -->
    <arg name="world_name" default="$(find robot_simulation)/world/room_with_corner.world"/>


    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="false"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="true"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>


    <!-- <include file="$(find robot_simulation)/launch/spawn_husky.launch">
        <arg name="laser_3d_enabled"          default="1"/>
    </include> -->

    <include file="$(find robot_simulation)/launch/spawn_scout_mini.launch">
    </include>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find robot_simulation)/rviz/run.rviz" />

</launch>
